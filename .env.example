# =============================================================================
# Capacity Connect - environment configuration
# Copy to .env (or run `npm run setup`, which also generates JWT_SECRET).
# NEVER commit the real .env file. Every secret below is intentionally empty.
# The API validates this configuration at start-up and refuses to boot with a
# list of what is wrong, so a typo here fails loudly rather than at request time.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (e.g. 1) so that rate
# limiting and audit logs see the real client IP. "false" disables.
TRUST_PROXY=false

# --- Database (PostgreSQL) ----------------------------------------------------
# Managed PostgreSQL in production (Neon, RDS, Cloud SQL, Supabase, ...). The
# default below matches `npm run db:local` (a local PostgreSQL with no setup).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect?schema=public
# Used only by the automated backend tests. Must end in "_test": they TRUNCATE
# every table in it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capacity_connect_test?schema=public

# --- Authentication -------------------------------------------------------------
# Signs access tokens. At least 32 characters. `npm run setup` generates one, or:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookies: COOKIE_SECURE=true is mandatory in production (the API refuses to
# start otherwise). COOKIE_SAMESITE: lax (same-site deploys), strict, or none
# (web app and API on different sites; requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# New self-registered accounts stay PENDING until an administrator approves them.
REGISTRATION_REQUIRES_APPROVAL=true
# Comma-separated allow-list for self-registration, e.g. imd.gov.in,moes.gov.in.
# Empty means any domain may register.
ALLOWED_EMAIL_DOMAINS=
# Account lock-out after repeated wrong passwords.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Argon2id cost. Raise both on production hardware.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# --- Web / CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Required in production. The
# FIRST entry also builds certificate verification links and QR codes.
FRONTEND_URL=http://localhost:5173

# --- File storage ------------------------------------------------------------------
# local -> files under STORAGE_LOCAL_DIR (development, single node)
# s3    -> any S3-compatible object store (AWS S3, MinIO, Cloudflare R2, ...)
#          STORAGE_BUCKET, STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY become required.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=capacity-connect
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# true for MinIO and most self-hosted stores, false for AWS S3.
STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25

# --- Certificates ---------------------------------------------------------------------
CERTIFICATE_ISSUER=India Meteorological Department, Ministry of Earth Sciences
# 2-8 upper-case letters or digits, used as the certificate-number prefix.
CERTIFICATE_ID_PREFIX=CC
# Ed25519 private key (PKCS#8 PEM, or that PEM base64-encoded) used to sign
# certificates. Generate one with `npm run cert:keygen`. Leave empty and
# certificates are issued UNSIGNED - public verification then reports them as
# unsigned rather than as valid. This is a secret: never logged, never returned
# by any endpoint, never committed.
CERTIFICATE_SIGNING_KEY=

# --- Rate limiting ------------------------------------------------------------------------
# Counters are held in memory, so each API instance has its own budget. Put a
# shared store or a gateway limit in front if you run several.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

# --- Background jobs -------------------------------------------------------------------------
# In-process scheduler for deadline and training reminders, guarded by a
# PostgreSQL advisory lock. Prefer an external cron calling
# POST /api/admin/jobs/reminders when running more than one API instance.
ENABLE_SCHEDULER=false

# --- Demo data (development only) --------------------------------------------------------------
# Password given to every seeded demo account. The seed refuses to run when
# NODE_ENV=production unless ALLOW_PRODUCTION_SEED=true. Never enable that on a
# real system: the seed creates well-known accounts.
SEED_DEMO_PASSWORD=
ALLOW_PRODUCTION_SEED=false

# --- Optional AI features (Phase 2) ---------------------------------------------------------------
# Off unless the chosen provider's key is set: every generative endpoint then
# answers 503 and the rest of the platform is unchanged. Plain-language search
# and the training-needs forecast work without a key.
# openai (GPT models, the default) or anthropic (Claude).
AI_PROVIDER=openai
# Secret. Leave empty to keep the AI features off.
OPENAI_API_KEY=
# Only for an OpenAI-compatible service other than OpenAI itself, for example
# https://example.com/v1. Must be https:// in production (localhost excepted).
OPENAI_BASE_URL=
# Secret. Only used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Model used for every AI call. Empty = gpt-4o-mini (OpenAI) or claude-opus-5
# (Anthropic).
AI_MODEL=
# Anthropic only: retry a declined request on the recommended fallback model.
AI_REFUSAL_FALLBACKS=true
# Per-user cap on AI requests per hour (they cost money).
AI_RATE_LIMIT_PER_HOUR=30
# Upper bound on the course material text sent with one request.
AI_MAX_CONTEXT_CHARS=120000

# --- Frontend build/dev (Vite reads only VITE_* variables) ----------------------------------------
# Absolute API base URL for an independently hosted web app, e.g.
# https://api.example.gov.in/api. Leave empty in development: the Vite dev
# server proxies /api to VITE_DEV_API_TARGET.
VITE_API_URL=
VITE_DEV_API_TARGET=http://localhost:4000
# Build-time: show the demo account shortcuts on the sign-in page. Leave false
# for any real deployment, and never put a real password in VITE_DEMO_PASSWORD -
# VITE_* values are compiled into the public bundle.
VITE_SHOW_DEMO_ACCOUNTS=false
VITE_DEMO_PASSWORD=
# Build-time: register the service worker in a development build, to exercise
# offline mode. Production builds always register it.
VITE_ENABLE_SW=false

# --- Docker Compose only --------------------------------------------------------------------------
# Read by docker-compose.yml, not by the API itself.
POSTGRES_USER=capacity
POSTGRES_DB=capacity_connect
# Required for Docker Compose. Letters and digits.
POSTGRES_PASSWORD=
# Public address of the stack; also becomes FRONTEND_URL for the API container.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Extra origins to add to the web app's Content-Security-Policy, e.g. an S3
# bucket origin serving uploads, or a separately hosted API.
CSP_EXTRA_ORIGINS=
